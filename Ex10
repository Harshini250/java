import java.sql.*;
public class Test3
{
public static void main(String s[])throws Exception
{
Connection con;
PreparedStatement ps;
Class.forName("com.mysql.jdbc.Driver");
con=DriverManager.getConnection("jdbc:mysql://localhost:3307/harshini","root","");
ps=con.prepareStatement("insert into student values(10,'harshini','Msc(CS)',7.35)");
ps.executeUpdate();
System.out.println("Insert Successfully");
ps=con.prepareStatement("UPDATE `student` SET `Dept`='ECE' WHERE `rollno`=10");
ps.executeUpdate();
System.out.println("Updated Successfully ");
ps=con.prepareStatement("SELECT * FROM `student` ");
